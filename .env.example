# TradingAgents Platform environment template
#
# Copy this file to `.env` in the repository root and fill in the values you use.
# The backend loader in `backend/app/core/config.py` will automatically read it.

#
# LLM providers
#
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

#
# Default LLM selection for analysis runs
#
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-reasoner
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-chat
TRADINGAGENTS_LLM_BACKEND_URL=https://api.deepseek.com

#
# Platform runtime
#
TRADINGAGENTS_PLATFORM_ENV=development
TRADINGAGENTS_FRONTEND_ORIGIN=http://127.0.0.1:3000
TRADINGAGENTS_PLATFORM_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
TRADINGAGENTS_PLATFORM_DATA_DIR=

#
# Alpaca paper / API mode
#
TRADINGAGENTS_ALPACA_ENABLED=true
TRADINGAGENTS_ALPACA_PAPER_MODE=api
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

#
# Interactive Brokers placeholder config
#
TRADINGAGENTS_IB_ENABLED=false
TRADINGAGENTS_IB_PAPER_MODE=simulator
TRADINGAGENTS_IB_HOST=127.0.0.1
TRADINGAGENTS_IB_PORT=7497
TRADINGAGENTS_IB_CLIENT_ID=101
TRADINGAGENTS_IB_ACCOUNT_ID=
