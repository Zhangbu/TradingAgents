TRADINGAGENTS_AUTH_MAX_LOGIN_ATTEMPTS=5
TRADINGAGENTS_AUTH_LOGIN_WINDOW_MINUTES=15
TRADINGAGENTS_AUTH_COOKIE_SECURE=false

TRADINGAGENTS_LLM_PROVIDER=nvidia
